{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "if [ -f \"${PLUGIN_ROOT}/hooks/session-start.mjs\" ]; then node \"${PLUGIN_ROOT}/hooks/session-start.mjs\" --host copilot; fi",
        "powershell": "if ($env:PLUGIN_ROOT -and (Test-Path -LiteralPath ($env:PLUGIN_ROOT + '/hooks/session-start.mjs'))) { node ($env:PLUGIN_ROOT + '/hooks/session-start.mjs') --host copilot }",
        "timeout": 5
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "if [ -f \"${PLUGIN_ROOT}/hooks/subagent-start.mjs\" ]; then node \"${PLUGIN_ROOT}/hooks/subagent-start.mjs\" --host copilot; fi",
        "powershell": "if ($env:PLUGIN_ROOT -and (Test-Path -LiteralPath ($env:PLUGIN_ROOT + '/hooks/subagent-start.mjs'))) { node ($env:PLUGIN_ROOT + '/hooks/subagent-start.mjs') --host copilot }",
        "timeout": 5
      }
    ]
  }
}
